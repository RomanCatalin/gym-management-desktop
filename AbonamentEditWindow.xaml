<Window x:Class="PIUG.AbonamentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PIUG"
        mc:Ignorable="d"
        Title="Editare Abonament"
        Height="470"
        Width="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border BorderBrush="#1e1627"
            BorderThickness="1"
            CornerRadius="0 0 10 10"
            Background="Transparent">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0"
                  Grid.Row="0"
                  Background="#3e2e52"
                  MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Editare Abonament"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="16" />

                <Button Grid.Column="2"
                        Width="30"
                        Height="30"
                        Margin="0,5,5,5"
                        Content="X"
                        Foreground="White"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        FontWeight="Bold"
                        Click="CloseButton_Click"
                        Cursor="Hand" />
            </Grid>

            <Grid Grid.Column="0"
                  Grid.Row="1" />

            <Border x:Name="SettingsBackground"
                    Grid.Row="1"
                    Grid.Column="0"
                    CornerRadius="0 0 10 10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0"
                                         EndPoint="0.5,1">
                        <GradientStop Color="White"
                                      Offset="0" />
                        <GradientStop Color="White"
                                      Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <StackPanel Margin="24,24,24,24"
                            VerticalAlignment="Top">

                    <Label x:Name="NameLabel"
                           Content="Nume persoană"
                           FontWeight="Bold"
                           Foreground="#4a3762"
                           FontSize="14" />
                    <TextBox x:Name="NameTextBox"
                             Height="30"
                             Margin="0,5,0,15"
                             Width="258" />

                    <Label x:Name="TipLabel"
                           Content="Tip abonament"
                           FontWeight="Bold"
                           Foreground="#4a3762"
                           FontSize="14" />
                    <ComboBox x:Name="TypeComboBox"
                              Height="30"
                              Margin="0,5,0,15"
                              Width="258">
                        <ComboBoxItem>Fitness</ComboBoxItem>
                        <ComboBoxItem>Fitness &amp; Group</ComboBoxItem>
                        <ComboBoxItem>One day</ComboBoxItem>
                    </ComboBox>

                    <Label x:Name="DateLabel"
                           Content="Dată început"
                           FontWeight="Bold"
                           Foreground="#4a3762"
                           FontSize="14" />
                    <DatePicker x:Name="StartDatePicker"
                                Height="30"
                                Margin="0,5,0,15"
                                Width="258" />

                    <Label x:Name="DateLabel2"
                           Content="Dată sfârșit"
                           FontWeight="Bold"
                           Foreground="#4a3762"
                           FontSize="14" />
                    <DatePicker x:Name="EndDatePicker"
                                Height="30"
                                Margin="0,5,0,30"
                                Width="258" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="OK"
                                Width="120"
                                Height="36"
                                Margin="0,0,15,0"
                                FontWeight="Bold"
                                Background="#4a3762"
                                Foreground="White"
                                Click="OkButton_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border x:Name="LoginBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter Property="Background"
                                                                Value="#a280be"
                                                                TargetName="LoginBorder" />
                                                        <Setter Property="TextBlock.Foreground"
                                                                Value="White"
                                                                TargetName="LoginBorder" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Anulează"
                                Width="120"
                                Height="36"
                                FontWeight="Bold"
                                Background="#a280be"
                                Foreground="White"
                                Click="CancelButton_Click">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border x:Name="LoginBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter Property="Background"
                                                                Value="#4a3762"
                                                                TargetName="LoginBorder" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
