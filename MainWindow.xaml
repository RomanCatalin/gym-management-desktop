<Window x:Class="PIUG.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PIUG"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="400"
        Width="500"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border x:Name="BorderBackground"
        BorderBrush="#1e1627"
            BorderThickness="1"
            CornerRadius="0 0 10 10"
            Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0"
                  Background="#3e2e52"
                  MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="SmartFit Management"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="14" />

                <Button Grid.Column="1"
                        Content="—"
                        Width="60"
                        Background="#663987"
                        Foreground="White"
                        BorderBrush="{x:Null}"
                        FontSize="16"
                        Click="MinimizeButton_Click"
                        ToolTip="Minimize" />
                <Button Grid.Column="2"
                        Content="X"
                        Width="60"
                        Background="#5f2a87"
                        Foreground="White"
                        BorderBrush="{x:Null}"
                        FontSize="16"
                        Click="CloseButton_Click"
                        ToolTip="Close" />
            </Grid>

            <!-- Main content -->
            <Border Grid.Row="1"
                    Background="Transparent"
                    CornerRadius="0 0 10 10"
                    Margin="10"
                    >
                <StackPanel Orientation="Vertical"
                            Margin="20">
                    <Image Height="100"
                           Width="236"
                           Source="/logo.png" />
                    <Grid VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="UserNameLabel"
                                   Text="Nume utilizator"
                                   Grid.Row="0"
                                   Margin="28,20,0,10"
                                   Foreground="#4a3762"
                                   HorizontalAlignment="Left"
                                   Width="142"
                                   FontWeight="Bold"
                                   FontSize="14" />
                        <TextBox x:Name="UserNameTextBox"
                                 Grid.Row="1"
                                 Padding="0,5"
                                 Width="381"
                                 BorderThickness="0,0,0,1"
                                 HorizontalAlignment="Center"
                                 Text="Introduceți nume..."
                                 Margin="0,0,0,46"
                                 Grid.RowSpan="2" />
                        <TextBlock x:Name="PasswordLabel"
                                   Text="Parolă utilizator"
                                   Grid.Row="2"
                                   Margin="28,39,0,5"
                                   Foreground="#4a3762"
                                   HorizontalAlignment="Left"
                                   Width="140"
                                   FontWeight="Bold"
                                   FontSize="14" />
                        <PasswordBox x:Name="PasswordBox"
                                     Grid.Row="3"
                                     Password="parola"
                                     Padding="0,5"
                                     Width="381"
                                     BorderThickness="0,0,0,1"
                                     HorizontalAlignment="Center" />
                        
                    </Grid>
                    
                    

                    <Button x:Name="LoginBtn"
                            Content="Autentificare"
                            Foreground="White"
                            Background="#4a3762"
                            Margin="0,25"
                            Height="35"
                            Width="250"
                            Click="LoginBtn_Click"
                            FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="LoginBorder"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="16">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Setter Property="Background"
                                                            Value="#a280be"
                                                            TargetName="LoginBorder" />
                                                    <Setter Property="TextBlock.Foreground"
                                                            Value="White"
                                                            TargetName="LoginBorder" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
