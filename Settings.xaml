<Window x:Class="PIUG.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PIUG"
        mc:Ignorable="d"
        Title="Settings"
        Height="320"
        Width="320"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Border around the entire window -->
    <Border BorderBrush="#1e1627"
            BorderThickness="1"
            CornerRadius="0 0 10 10"
            Background="Transparent">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <!-- Title bar -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Title bar -->
            <Grid Grid.Column="0"
                  Grid.Row="0"
                  Background="#3e2e52"
                  MouseDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Setări"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="16" />
            </Grid>

            <!-- Main content area -->
            <Grid Grid.Column="0"
                  Grid.Row="1" />

            <Border x:Name="SettingsBackground"
                    Grid.Row="1"
                    Grid.Column="0"
                    CornerRadius="0 0 10 10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0"
                                         EndPoint="0.5,1">
                        <GradientStop Color="White"
                                      Offset="0" />
                        <GradientStop Color="White"
                                      Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Dark Mode Label + Checkbox -->
            <StackPanel Orientation="Horizontal"
                        Margin="24,38,0,0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Grid.Row="1">
                <Label x:Name="DarkModeLabel"
                       Content="Dark Mode"
                       Height="42"
                       Width="212"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#4a3762" />
                <CheckBox Name="DarkModeCheckbox"
                          VerticalAlignment="Center"
                          Margin="10,0,0,0"
                          Checked="DarkModeCheckbox_Checked"
                          Unchecked="DarkModeCheckbox_Unchecked"/>
            </StackPanel>

            <!-- Retinere Setari Label + Checkbox -->
            <StackPanel Orientation="Horizontal"
                        Margin="24,104,0,0"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Grid.Row="1">
                <Label x:Name="RetinereSetariLabel"
                    Content="Reținere setări"
                       Height="42"
                       Width="212"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#4a3762" />
                <CheckBox Name="SaveSettingsCheckbox"
                          VerticalAlignment="Center"
                          Margin="10,0,0,0"
                          Checked="SaveSettingsCheckbox_Checked"
                          Unchecked="SaveSettingsCheckbox_Unchecked"/>
            </StackPanel>

            <!-- Return Button -->
            <Button x:Name="BT_1_Copy2"
                    Content="Revenire"
                    Foreground="White"
                    Background="#4a3762"
                    Width="250"
                    Height="50"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20"
                    Click="LoginBtn_Click"
                    Grid.Row="1"
                    FontSize="18"
                    FontWeight="Bold">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border x:Name="LoginBorder"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="15">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#a280be"
                                                    TargetName="LoginBorder" />
                                            <Setter Property="TextBlock.Foreground"
                                                    Value="White"
                                                    TargetName="LoginBorder" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

        </Grid>
    </Border>
</Window>
